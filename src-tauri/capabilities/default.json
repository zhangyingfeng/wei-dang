{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the app's own main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:4417/*"]
  },
  "permissions": [
    "core:default",
    "allow-open-login-window",
    "allow-close-login-window",
    "allow-weixin-fetch",
    "allow-wait-for-login",
    "allow-resize-main-window",
    "allow-logout",
    "allow-check-login-status",
    "dialog:allow-open",
    "dialog:allow-message",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
