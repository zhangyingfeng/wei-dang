{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "微档",
  "version": "0.1.0",
  "identifier": "com.zhangyingfeng.weidang",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://127.0.0.1:4417",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public": "public"
    },
    "externalBin": [
      "binaries/weidang-server"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: YingFeng Zhang (P38K63763C)"
    }
  }
}
